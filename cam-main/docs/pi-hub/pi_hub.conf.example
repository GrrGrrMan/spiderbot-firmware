# Copy values into Rpi/conf/pi_hub.conf on a Pi hub.
# Keep the real file ignored.

PI_HUB_MQTT_USER="spiderbot"
PI_HUB_MQTT_PASSWORD="change-me"
PI_HUB_MQTT_PORT=1883

# If the hotspot is advertising but Mosquitto dies, the Pi repairs Mosquitto
# first. If repair fails, it stops spiderlink so ESPs can fall back to another
# whitelisted WiFi instead of staying on a dead hotspot broker.
PI_HUB_BROKER_WATCHDOG_ENABLE=1
PI_HUB_BROKER_WATCHDOG_INTERVAL_SEC=30
PI_HUB_BROKER_WATCHDOG_RESTART_WAIT_SEC=3
PI_HUB_BROKER_WATCHDOG_STOP_HOTSPOT_ON_FAILURE=1

PI_HUB_TAILSCALE_ENABLE=1
PI_HUB_TAILSCALE_AUTH_KEY=""
PI_HUB_TAILSCALE_HOSTNAME=""

PI_HUB_ESP_LINK_ENABLE=1
PI_HUB_LINK_TOKEN="change-me-long-random"
PI_HUB_LINK_HOST=""
PI_HUB_LINK_TTL_SEC=0
PI_HUB_ESP_CONTROL_PORT=7777
PI_HUB_ESP_SCAN_INTERVAL_SEC=10
PI_HUB_ESP_FULL_SCAN_INTERVAL_SEC=60
PI_HUB_ESP_RELINK_SEC=60
PI_HUB_ESP_ALLOWED_ROOTS="alphaesp32/spiderbot01,alphaesp32s3/spiderbot-s3"

PI_HUB_ENABLE_MULTI_WIFI=0
PI_WIFI_PERSONAL_NETWORKS=(
  "home|YourWifiName|wifi-password|80"
)

PI_HUB_ENABLE_HOTSPOT=1
PI_HUB_HOTSPOT_SSID="spiderlink"
PI_HUB_HOTSPOT_PASS="spiderbot"
PI_HUB_HOTSPOT_AP_IFACE="wlan-ap"
PI_HUB_HOTSPOT_IP="192.168.4.1"
PI_HUB_HOTSPOT_COUNTRY="NZ"
PI_HUB_HOTSPOT_CHANNEL=6
