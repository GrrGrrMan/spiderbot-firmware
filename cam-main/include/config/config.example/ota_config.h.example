#pragma once

#include <Arduino.h>

struct OtaSourceConfig {
    String owner;
    String repo;
    String branch;
    String projectPath;
    String artifactName;
    bool isPrivate;
    String authToken;
};


// Primary Repo Configuration (e.g. Private GitHub)
#define OTA_PRIMARY_OWNER    "YourOrg"
#define OTA_PRIMARY_REPO     "hexapod-firmware"
#define OTA_PRIMARY_BRANCH   "main"
#define OTA_PRIMARY_ARTIFACT "firmware"
#define OTA_PRIMARY_PRIVATE  true
#define OTA_PRIMARY_TOKEN    "github_pat_SECRET_TOKEN"

// Fallback Repo Configuration (e.g. Public GitHub)
#define OTA_FALLBACK_OWNER    "YourOrg"
#define OTA_FALLBACK_REPO     "hexapod-firmware-public"
#define OTA_FALLBACK_BRANCH   "main"
#define OTA_FALLBACK_ARTIFACT "firmware"
#define OTA_FALLBACK_PRIVATE  false
#define OTA_FALLBACK_TOKEN    ""