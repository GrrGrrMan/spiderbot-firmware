#pragma once
#include <ArduinoJson.h>
#include <WiFi.h>
#include "cam_config.h"

#define CMD_TYPE_SYSTEM       "system"
#define CMD_TYPE_OTA          "ota"
#define CMD_TYPE_CAMERA       "camera"   // Dynamic camera configuration command

inline void buildConfigPayload(JsonDocument& doc, const String& deviceId) {
    doc["device_id"] = deviceId;
    doc["sensor"]    = "OV3660";

    const String ip = WiFi.localIP().toString();
    if (ip.length() > 0 && ip != "0.0.0.0") {
        doc["mjpeg_url"] = "http://" + ip + ":" + String(CAM_STREAM_PORT) + "/stream";
    }
}