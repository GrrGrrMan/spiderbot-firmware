# ==============================================================================
# Credentials & Sensitive Configurations
# ==============================================================================
*.env
**/*.env
!*.env.example
!**/*.env.example

# ==============================================================================
# Firmware Sensitive Configs (Keep .example files and templates)
# ==============================================================================
# Ignore all files in include/config
**/include/config/*

# Allow subfolders (like config.example/)
!**/include/config/*/

# Allow example files anywhere inside include/config
!**/include/config/*.example
!**/include/config/**/*.example
!**/include/config/**/config.example/**

# ==============================================================================
# PlatformIO & Embedded Build Artifacts
# ==============================================================================
.pio/
.piohome/
.cache/
*.elf
*.bin
*.hex
*.map
*.vcd
compile_commands.json
.clangd/

# ==============================================================================
# IDE & System Metadata
# ==============================================================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/c_cpp_properties.json

# OS Metadata
.DS_Store
Thumbs.db
*.swp
*~